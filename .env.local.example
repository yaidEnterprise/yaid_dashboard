# Estágio do projeto
STAGE=DOTENV

# Endpoint do app
# Sem barra final — ex.: https://app.exemplo.com
# (a URL de verificação é derivada inline como ${NEXT_PUBLIC_APP_URL}/v/<token>)
NEXT_PUBLIC_APP_URL=YOUR_APP_ENDPOINT

# Supabase
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY
# Supabase CLI only (supabase db pull/push/link) — not read by the app itself
SUPABASE_DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# Blockchain
BLOCKCHAIN_RPC_URL=YOUR_BLOCKCHAIN_RPC_URL
BLOCKCHAIN_WALLET_PRIVATE_KEY=YOUR_WALLET_PRIVATE_KEY
BLOCKCHAIN_CONTRACT_ADDRESS=YOUR_BLOCKCHAIN_CONTRACT_ADDRESS

# Emissao de VC (fora da chain)
ISSUER_PRIVATE_KEY=YOUR_ISSUER_PRIVATE_KEY

# Webhook
WEBHOOK_SIGNING_PRIVATE_KEY=YOUR_WEBHOOK_SIGNING_PRIVATE_KEY

# OCR (Mistral Document AI — modelo e endpoint são constantes no client)
MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY